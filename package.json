{
  "name": "fresh-move",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/write-headers.ts && astro build && node scripts/check-client-secrets.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "astro build && playwright test",
    "test:all": "npm run check && npm run lint && npm run test && npm run test:e2e",
    "copy-review": "node scripts/copy-review.mjs",
    "placeholders": "node scripts/make-placeholders.mjs",
    "icons": "node scripts/make-icons.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "db:lint": "node scripts/db-check.mjs",
    "test:db": "node scripts/with-local-supabase.mjs vitest run --config vitest.db.config.ts",
    "db:seed": "node scripts/with-local-supabase.mjs node scripts/seed-trips.ts",
    "setup:local": "node scripts/setup-local-env.mjs",
    "cf:types": "wrangler types --include-runtime=false",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@jsquash/webp": "1.5.0",
    "@supabase/ssr": "^0.12.7",
    "astro": "^7.4.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@supabase/supabase-js": "^2.119.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "lighthouse": "^13.6.0",
    "supabase": "^3.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "^6.3.0"
    }
  },
  "allowScripts": {
    "workerd@1.20261101.1": true,
    "workerd@1.20261104.1": true,
    "esbuild@0.28.2": true
  }
}
