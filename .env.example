# Public values (bundled into the browser code). Copy to .env, or run: npm run setup:local
SITE_URL=http://localhost:4321
PUBLIC_SUPABASE_URL=
# The Supabase "publishable" key (sb_publishable_…). Safe in the browser; RLS applies.
PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key. Test key that always passes: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
