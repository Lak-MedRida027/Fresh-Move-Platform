# Production build values for `npm run deploy` (copy to .env.production; that file is gitignored).
# All of these end up in the public site: NO secrets here. Secrets: npx wrangler secret put <NAME>.
# Where to find each value: docs/DEPLOY.md.

# The site's address, no trailing slash (Workers subdomain, or your custom domain later).
SITE_URL=https://fresh-move.YOUR-SUBDOMAIN.workers.dev
# Supabase → Project Settings → API Keys / Data API.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Cloudflare → Turnstile → your widget → Site key.
PUBLIC_TURNSTILE_SITE_KEY=0x...
