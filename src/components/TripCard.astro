---
import TerrainTag from './TerrainTag.astro';
import TripPhoto from './TripPhoto.astro';
import SeatsBadge from './SeatsBadge.astro';
import { getRegion } from '../data/regions';
import { localizePath, useTranslations, type Locale } from '../i18n';
import { formatDateRange } from '../lib/dates';
import { formatTripDate, type Trip } from '../lib/trips';

interface Props {
  trip: Trip;
  locale: Locale;
  headingLevel?: 'h2' | 'h3';
  /** 'upcoming': poster crop, dates, price, level and seats. */
  variant?: 'past' | 'upcoming';
}
const { trip, locale, headingLevel = 'h3', variant = 'past' } = Astro.props;
const t = useTranslations(locale);
const title = trip.title[locale];
const href = localizePath(`/trips/${trip.slug}/`, locale);
const Heading = headingLevel;
const primary = trip.terrain[0] ?? 'mountain';
const upcoming = variant === 'upcoming';
const numberFmt = new Intl.NumberFormat(locale === 'ar' ? 'ar-DZ' : 'en');
---

<article class:list={['trip-card', { 'trip-card--upcoming': upcoming }]} data-terrain={primary}>
  <div class="trip-card__media">
    {
      trip.cover && (
        <TripPhoto
          image={trip.cover}
          locale={locale}
          alt=""
          sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw"
        />
      )
    }
  </div>
  <div class="trip-card__body">
    <ul class="trip-card__tags" role="list">
      {trip.terrain.map((terrain) => <li><TerrainTag terrain={terrain} locale={locale} /></li>)}
      {upcoming && trip.difficulty && <li class="trip-card__level">{t(`difficulty.${trip.difficulty}`)}</li>}
    </ul>
    <Heading class="trip-card__title">
      <a href={href} class="trip-card__link">
        {locale === 'en' ? <span class="display">{title}</span> : <span class="display-ar">{title}</span>}
      </a>
    </Heading>
    {locale === 'ar' && <p class="trip-card__latin display" lang="en" dir="ltr">{trip.title.en}</p>}
    <p class="trip-card__meta">
      <span>{getRegion(trip.region).name[locale]}</span>
      <span aria-hidden="true">·</span>
      <span class="trip-card__date">
        {upcoming && trip.startDate ? formatDateRange(trip.startDate, trip.endDate, locale) : formatTripDate(trip.startDate, locale)}
      </span>
    </p>
    {
      upcoming ? (
        <div class="trip-card__book">
          {trip.priceDa !== null && (
            <p class="trip-card__price">{t('price.da', { price: numberFmt.format(trip.priceDa) })}</p>
          )}
          <SeatsBadge trip={trip} locale={locale} />
        </div>
      ) : (
        <p class="trip-card__summary">{trip.summary[locale]}</p>
      )
    }
  </div>
</article>

<style>
  .trip-card {
    position: relative;
    display: flex;
    flex-direction: column;
    block-size: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      transform 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out);
  }
  .trip-card:hover {
    transform: translateY(-3px);
    border-color: var(--terrain);
  }
  .trip-card:focus-within {
    border-color: var(--focus);
  }
  .trip-card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--burnt-earth);
  }
  .trip-card--upcoming .trip-card__media {
    aspect-ratio: 4 / 5;
  }
  .trip-card__media::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    block-size: 4px;
    background: var(--terrain);
  }
  .trip-card__body {
    display: grid;
    gap: 0.5rem;
    padding: 1.1rem 1.2rem 1.4rem;
    align-content: start;
  }
  .trip-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .trip-card__level {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    font-size: 0.78rem;
    font-weight: 600;
  }
  .trip-card__title {
    font-size: 1.45rem;
    line-height: 1.25;
  }
  .trip-card__link {
    color: var(--fg);
    text-decoration: none;
  }
  /* Whole card is clickable; the real link stays the heading for screen readers. */
  .trip-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .trip-card__link:focus-visible {
    outline: none;
  }
  .trip-card__latin {
    font-size: 0.8rem;
    color: var(--fg-muted);
    font-weight: 600;
    text-align: end;
  }
  .trip-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--fg-muted);
    font-size: 0.9rem;
  }
  .trip-card__summary {
    font-size: 0.95rem;
  }
  .trip-card__book {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-block-start: 0.25rem;
  }
  .trip-card__price {
    font-family: var(--font-display-latin);
    font-weight: 700;
    font-size: 1.35rem;
    color: var(--sand-text);
  }
  :global(html[lang^='ar']) .trip-card__price {
    font-family: var(--font-arabic);
  }
</style>
