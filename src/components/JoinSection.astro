---
import SectionHeading from './SectionHeading.astro';
import JoinForm from './JoinForm.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** On /join/ the section title is the page h1. */
  asPage?: boolean;
}
const { locale, asPage = false } = Astro.props;
const t = useTranslations(locale);
---

<section class="section join" id="join" aria-labelledby="join-title">
  <div class="container join__inner">
    <SectionHeading
      eyebrow={t('join.eyebrow')}
      title={t('join.title')}
      intro={t('join.intro')}
      id="join-title"
      level={asPage ? 'h1' : 'h2'}
    />
    <JoinForm locale={locale} successLevel={asPage ? 'h2' : 'h3'} />
  </div>
</section>

<style>
  .join {
    background:
      radial-gradient(ellipse at 20% 0%, color-mix(in srgb, var(--accent-olive) 18%, transparent), transparent 60%),
      var(--bg);
  }
  .join__inner {
    max-inline-size: 46rem;
  }
</style>
