---
// Rendered on request from Supabase (cached ~60 s at the edge, tag "trips").
import TripPage from '../../../views/TripPage.astro';
import NotFoundPage from '../../../views/NotFoundPage.astro';
import { getTripWithSeats } from '../../../lib/trips';

const slug = Astro.params.slug ?? '';
const trip = /^[a-z0-9-]{1,80}$/.test(slug) ? await getTripWithSeats(slug) : null;
if (!trip) Astro.response.status = 404;
else if (Astro.cache?.enabled) Astro.cache.set({ maxAge: 60, swr: 300, tags: ['trips', `trip:${trip.id}`] });
---

{trip ? <TripPage locale="en" trip={trip} /> : <NotFoundPage locale="en" />}
