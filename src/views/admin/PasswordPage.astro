---
/**
 * Choose a password: after an invitation or reset link (password-only
 * session), or from the admin menu. Someone who already has MFA but hasn't
 * entered the code in this session goes through the MFA page first (the route
 * pages do that redirect: only pages can redirect).
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminT } from '../../i18n/admin';
import type { Locale } from '../../i18n';
import { MIN_PASSWORD } from '../../lib/admin/auth';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = adminT(locale);
// (The route page sends anyone with MFA but no code yet to the MFA page first.)
const pending = Astro.locals.pendingMfa;
const isNew = !!pending; // invited, no MFA yet: the authenticator setup comes next
const email = (Astro.locals.admin ?? pending)?.email ?? '';
---

<AdminLayout locale={locale} title={t('pw.title')} bare={isNew}>
  <section class="auth-card form-card" aria-labelledby="pw-title">
    <h1 id="pw-title">{t('pw.title')}</h1>
    {isNew && <p class="muted-sm">{t('pw.newAdmin')}</p>}
    <form class="form" method="post" action="/admin/api/password/" data-password-form>
      <input type="hidden" name="lang" value={locale} />
      {/* Lets password managers save the new password under the right account. */}
      <input type="email" name="username" value={email} autocomplete="username" hidden readonly />
      <div class="field">
        <label class="field__label" for="pw-new">{t('pw.new')}</label>
        <input
          class="field__input field__input--ltr"
          id="pw-new"
          name="password"
          type="password"
          autocomplete="new-password"
          dir="ltr"
          required
          minlength={MIN_PASSWORD}
          maxlength="200"
          aria-describedby="pw-help"
        />
      </div>
      <div class="field">
        <label class="field__label" for="pw-repeat">{t('pw.repeat')}</label>
        <input
          class="field__input field__input--ltr"
          id="pw-repeat"
          name="password_repeat"
          type="password"
          autocomplete="new-password"
          dir="ltr"
          required
          minlength={MIN_PASSWORD}
          maxlength="200"
        />
      </div>
      <p class="muted-sm" id="pw-help">{t('pw.help', { min: MIN_PASSWORD })}</p>
      <button class="btn btn-primary form__submit" type="submit">{t('pw.submit')}</button>
    </form>
  </section>
</AdminLayout>
