---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { localizePath, otherLocale, LOCALE_META, t as translate, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
// Vercel serves the root 404 for every missing URL, so it also shows the other language.
const other = otherLocale(locale);
---

<BaseLayout locale={locale} title={t('meta.notFound.title')} description={t('notFound.text')} noindex>
  <section class="notfound">
    <div class="container notfound__inner">
      <Icon name="compass" size={64} class="notfound__icon" />
      <p class="notfound__code display" aria-hidden="true">404</p>
      <h1 class="notfound__title">{t('notFound.title')}</h1>
      <p class="notfound__text">{t('notFound.text')}</p>
      <div class="notfound__actions">
        <a class="btn btn-primary" href={localizePath('/', locale)}>{t('notFound.home')}</a>
        <a class="btn btn-ghost" href={localizePath('/trips/', locale)}>{t('nav.trips')}</a>
      </div>
      <div class="notfound__other" lang={LOCALE_META[other].lang} dir={LOCALE_META[other].dir}>
        <p class="notfound__other-title">{translate(other, 'notFound.title')}</p>
        <p class="muted">{translate(other, 'notFound.text')}</p>
        <a href={localizePath('/', other)}>{translate(other, 'notFound.home')}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: clamp(4rem, 12vw, 8rem) 2rem;
    background:
      radial-gradient(ellipse at 50% 0%, color-mix(in srgb, var(--accent-sand) 14%, transparent), transparent 60%),
      var(--bg);
  }
  .notfound__inner {
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
    max-inline-size: 40rem;
  }
  .notfound :global(.notfound__icon) {
    color: var(--accent-sand);
  }
  .notfound__code {
    font-size: clamp(4rem, 20vw, 7rem);
    line-height: 1;
    color: var(--border);
  }
  .notfound__title {
    font-size: clamp(2rem, 8vw, 3rem);
  }
  .notfound__text {
    font-size: 1.1rem;
    color: var(--fg-muted);
  }
  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-block-start: 0.5rem;
  }
  .notfound__other {
    display: grid;
    gap: 0.4rem;
    margin-block-start: 2.5rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--border);
    inline-size: 100%;
  }
  .notfound__other-title {
    font-weight: 700;
    font-size: 1.2rem;
  }
  .notfound__other a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--tap);
  }
</style>
